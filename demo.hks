(* HksScript Demo: OCaml-style image processing script *)

(* 1. Load an image *)
let img : Mat = load "test.png";

(* 2. Detect circles *)
let circles = Find.findCircle(img);

(* 3. Create features *)
let area = Area.new();

(* 4. Simple query *)
let r1 = circles.query(area < 0);

(* 5. Compound conditions using or / and / not with parentheses *)
let r2 = circles.query(area < 0 or area > 10);
let r3 = circles.query(area < 5 and area > 0);
let r4 = circles.query(not (area < 0) and area > 10);

print("done");
