{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HKS Script",
  "scopeName": "source.hkscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": "\\(\\*", "end": "\\*\\)", "name": "comment.block.hkscript" },
        { "begin": "#", "end": "$", "name": "comment.line.number-sign.hkscript" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(import|def|if|elif|else|return|query|from|with|and|or|not|true|false)\\b",
          "name": "keyword.control.hkscript" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(int|float|string|bool|Mat|Set|Circle|Range|void)\\b",
          "name": "storage.type.hkscript" }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.hkscript",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.hkscript" }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b\\d+(\\.\\d+)?\\b", "name": "constant.numeric.hkscript" }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "=>|\\|>|>=|<=|==|!=|->|\\||&|[-+*/=<>!]",
          "name": "keyword.operator.hkscript" }
      ]
    },
    "builtins": {
      "patterns": [
        { "match": "\\b(load|save|print|len|range|query)\\b",
          "name": "support.function.hkscript" }
      ]
    }
  }
}
