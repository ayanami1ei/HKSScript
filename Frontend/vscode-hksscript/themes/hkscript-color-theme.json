{
  "name": "HKS Script Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4"
  },
  "tokenColors": [
    {
      "scope": "keyword.control.hkscript",
      "settings": { "foreground": "#cba6f7", "fontStyle": "bold" }
    },
    {
      "scope": "storage.type.hkscript",
      "settings": { "foreground": "#a6e3a1" }
    },
    {
      "scope": "entity.name.function",
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": "support.function.hkscript",
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": "string.quoted.double.hkscript",
      "settings": { "foreground": "#89b4fa" }
    },
    {
      "scope": "constant.numeric.hkscript",
      "settings": { "foreground": "#fab387" }
    },
    {
      "scope": "comment.line.number-sign.hkscript, comment.block.hkscript",
      "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
    },
    {
      "scope": "keyword.operator.hkscript",
      "settings": { "foreground": "#89dceb" }
    },
    {
      "scope": "variable.hkscript",
      "settings": { "foreground": "#cdd6f4" }
    }
  ]
}
