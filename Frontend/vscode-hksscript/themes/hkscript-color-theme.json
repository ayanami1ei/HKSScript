{
  "name": "HKS Script",
  "type": "dark",
  "tokenColors": [
    { "scope": "source.hkscript keyword.control.hkscript",      "settings": { "foreground": "#cba6f7", "fontStyle": "bold" } },
    { "scope": "source.hkscript entity.name.function",           "settings": { "foreground": "#f9e2af" } },
    { "scope": "source.hkscript support.function.hkscript",      "settings": { "foreground": "#f9e2af" } },
    { "scope": "source.hkscript storage.type.hkscript",          "settings": { "foreground": "#a6e3a1" } },
    { "scope": "source.hkscript variable.hkscript",              "settings": { "foreground": "#cdd6f4" } },
    { "scope": "source.hkscript string.quoted.double.hkscript",  "settings": { "foreground": "#89b4fa" } },
    { "scope": "source.hkscript constant.numeric.hkscript",      "settings": { "foreground": "#fab387" } },
    { "scope": "source.hkscript comment.line.number-sign.hkscript, source.hkscript comment.block.hkscript", "settings": { "foreground": "#6c7086", "fontStyle": "italic" } },
    { "scope": "source.hkscript keyword.operator.hkscript",      "settings": { "foreground": "#89dceb" } }
  ]
}
