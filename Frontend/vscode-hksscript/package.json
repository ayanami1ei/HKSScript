{
  "name": "hksscript",
  "displayName": "HKS Script",
  "description": "HKS Script language support: syntax highlighting and basic syntax checking",
  "version": "0.1.0",
  "publisher": "hksscript",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayanami1ei/HKSScript.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:hksscript"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hksscript",
        "aliases": [
          "HKS Script",
          "hksscript"
        ],
        "extensions": [
          ".hks"
        ],
    "configuration": "./language-configuration.json",
    "semanticHighlighting": true
      }
    ],
    "configuration": {
      "title": "HKS Script",
      "properties": {
        "hkscript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the HksScript CLI DLL (HKSScript.dll). Leave empty for auto-detect."
        }
      }
    },
    "themes": [
      {
        "label": "HKS Script",
        "uiTheme": "vs-dark",
        "path": "./themes/hkscript-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}
