{
  "name": "hksscript",
  "displayName": "HKS Script",
  "description": "HKS Script language support: syntax highlighting and basic syntax checking",
  "version": "0.1.0",
  "publisher": "hksscript",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:hksscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hksscript",
        "aliases": [
          "HKS Script",
          "hksscript"
        ],
        "extensions": [
          ".hks"
        ],
        "configuration": "./language-configuration.json",
        "semanticHighlighting": true
      }
    ],
    "grammars": [
      {
        "language": "hksscript",
        "scopeName": "source.hksscript",
        "path": "./syntaxes/hksscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "HKS Script",
      "properties": {
        "hksscript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the HksScript CLI DLL (HKSScript.dll). Leave empty for auto-detect."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "hksscript",
        "scopes": {
          "function": [
            "entity.name.function"
          ],
          "type": [
            "support.type"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "antlr4": "4.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}
