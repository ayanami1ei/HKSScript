{
  "scopeName": "source.hksscript",
  "fileTypes": [".hks"],
  "name": "HksScript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": "\\(\\*", "end": "\\*\\)", "name": "comment.block.hkscript" },
        { "begin": "#", "end": "$", "name": "comment.line.number-sign.hkscript" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(import|def|if|elif|else|return|query|from|with|and|or|not|true|false)\\b", "name": "keyword.control.hkscript" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(int|float|string|bool|Mat|Set|Circle|Range|void)\\b", "name": "storage.type.hkscript" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hkscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.hkscript", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b\\d+\\.\\d+\\b", "name": "constant.numeric.float.hkscript" },
        { "match": "\\b\\d+\\b", "name": "constant.numeric.integer.hkscript" }
      ]
    },
    "builtins": {
      "patterns": [
        { "match": "\\b(load|save|print|len|range)\\b", "name": "support.function.hkscript" }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "=>|->", "name": "keyword.operator.hkscript" },
        { "match": "[+\\-*/=<>!]=?|!=|&|\\|", "name": "keyword.operator.hkscript" }
      ]
    }
  }
}
